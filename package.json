{
  "name": "mohar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "wallets": "tsx scripts/wallets.ts",
    "balance": "tsx scripts/balance.ts",
    "demo": "tsx scripts/demo.ts",
    "fund": "tsx scripts/fund.ts",
    "send": "tsx scripts/send.ts",
    "brand": "tsx scripts/brand-assets.ts",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:chain": "vitest run --config vitest.chain.config.ts",
    "test:e2e": "npm run build && playwright test",
    "seal": "tsx scripts/seal.ts",
    "reveal": "tsx scripts/reveal.ts",
    "test:e2e:prod": "E2E_BASE_URL=https://mohar.live playwright test",
    "shots": "node scripts/screenshots.mjs",
    "keep-alive": "tsx scripts/keep-alive.ts",
    "evidence": "tsx scripts/evidence.ts",
    "test:report": "tsx scripts/test-report.ts",
    "big-paper": "tsx scripts/big-paper.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "@vercel/og": "0.8.5",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.8",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
