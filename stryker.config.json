{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --reporter=dot"
  },
  "mutate": [
    "src/lib/hash.ts",
    "src/lib/rules.ts",
    "src/ui/verdict.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 90000,
  "reporters": [
    "progress-append-only",
    "clear-text",
    "html"
  ],
  "clearTextReporter": {
    "allowColor": false,
    "logTests": false
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  }
}
